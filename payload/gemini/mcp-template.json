{
  "mcpServers": {
    "chrome-devtools-mcp": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@1.9.0"
      ],
      "disabled": true,
      "env": {}
    },
    "github-mcp-server": {
      "serverUrl": "https://api.githubcopilot.com/mcp/",
      "disabled": true,
      "headers": {
        "Authorization": "${SECRET_REQUIRED}"
      }
    },
    "sequential-thinking": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-sequential-thinking@2026.8.31"
      ],
      "disabled": true,
      "env": {}
    }
  }
}